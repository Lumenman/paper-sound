@echo off
rem prep.bat, но верх не поднят, а срезан. Гипотеза, на бумаге ещё не мерена.
rem
rem   prep5.bat [вход.wav] [выход.wav]   (по умолчанию data\input.wav)
rem
rem ЗАЧЕМ. prep4 поднял верх и проиграл 1.24 dB (LAB §23.8): выше ~2500 Гц
rem носитель не ослаблен, а насыщен -- штрих переезжает A*2pi*f/sr px за ряд,
rem и лишняя амплитуда там возвращается не звуком, а ошибкой. rows_2026-10
rem (LAB §28) сказал то же с другой стороны: клавесин, у которого верха много,
rem читается на ~7 dB хуже голоса, и ошибка ридера живёт там, где крутизна.
rem Обратный шаг -- не тратить размах штриха на то, что лист всё равно не
rem донесёт: ни +4 на 2600, ни того, что выше 2800.
rem
rem ЧТО ДРУГОГО. Одна строка, как у prep4: вместо `equalizer 2600 1.0q +4`
rem стоит `lowpass 2800` (два полюса, -3 dB на 2800). Компандер, клип и
rem уровень -- как в prep.bat, чтобы разница на бумаге была разницей верха.
rem
rem ЧЕМ ПЛАТИМ. Звук глуше: согласные тусклее, чем в prep.bat. Судить ухом, и
rem dB против своего же печатного файла здесь не мера: у файла без верха
rem меньше того, в чём можно ошибиться (LAB §28, prep4 «КАК СУДИТЬ»).

setlocal
set SOX=%~dp0..\sox\sox.exe
rem sox: сначала свой, рядом с проектом, потом любой из PATH.
if not exist "%SOX%" set SOX=sox
set IN=%~1
if "%IN%"=="" set IN=%~dp0..\data\input.wav
set OUT=%~2
if "%OUT%"=="" set OUT=%~dp0..\data\out5.wav
set SECS=120

rem СКОЛЬКО ЖАТЬ. Как в prep.bat, меню там же.
set CLIP=6:-9,-8,0,-5

"%SOX%" "%IN%" -b 16 "%OUT%" ^
 trim 0 %SECS% ^
 gain -6 ^
 lowpass 2800 ^
 highpass 80 ^
 compand 0.002,0.25 6:-65,-90,-40,-14,-20,-9,0,-5 0 -90 0.1 ^
 compand 0,0 %CLIP% 0 -90 ^
 rate -v 6780 ^
 gain -n -1
if errorlevel 1 exit /b 1

echo.
"%SOX%" "%OUT%" -n stats
endlocal
